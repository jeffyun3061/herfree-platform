# Dev S3 + OAuth — gitignored. Never commit.
# 복사: copy backend\local-secrets.yml.example → backend\local-secrets.yml
app:
  s3:
    bucket: "herfree-dev-uploads"
    access-key: "YOUR_DEV_ACCESS_KEY"
    secret-key: "YOUR_DEV_SECRET_KEY"

  # ── 소셜 로그인 (secret 은 이 파일에만) ─────────────────────────────
  oauth:
    kakao:
      # 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키 (32자 hex)
      client-id: "YOUR_KAKAO_REST_API_KEY"
      # 선택: 보안 > Client Secret 코드 사용 ON 일 때만 (없으면 비워 두기)
      client-secret: ""
      redirect-uri: "http://localhost:3000/auth/callback/kakao"
    google:
      # Google Cloud > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
      client-id: "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
      client-secret: "YOUR_GOOGLE_CLIENT_SECRET"
      redirect-uri: "http://localhost:3000/auth/callback/google"
    naver:
      # 네이버 developers > Application > Client ID / Client Secret (서로 다른 값)
      # 서비스 URL: http://localhost:3000
      # Callback URL: http://localhost:3000/auth/callback/naver
      client-id: "YOUR_NAVER_CLIENT_ID"
      client-secret: "YOUR_NAVER_CLIENT_SECRET"
      redirect-uri: "http://localhost:3000/auth/callback/naver"

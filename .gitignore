# Environment & secrets (never commit)
tmp-ssm.json
tmp-*.json
**/*-ssm.json
.env
.env.staging
.env.prod
.env.*.local
.env.*.production
!.env.prod.example
!backend/.env.example
!backend/local-secrets.yml.example
backend/.env
backend/local-secrets.yml
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-secret.yml
backend/src/main/resources/application-prod.yml
frontend/.env.local
frontend/.env.production

# 같은 파일이 하위 폴더에 복사되어도 추적하지 않는다.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/local-secrets.yml
**/application-local.yml
**/application-prod.yml
**/application-secret.yml
**/secrets/**
*.key
*.jks
*.keystore

# AWS / credential exports (any folder)
**/*accessKeys*.csv
**/*access*key*.csv
**/*credentials*.csv
*.pem
*.p12
*.pfx
!infra/certs/rds-global-bundle.pem

# Logs
*.log
logs/

# IDE / editor (local only — do not commit)
.idea/
.vscode/
.cursor/
*.iml

# OS
.DS_Store
Thumbs.db

# Uploads / local files
files/


# 로컬 개발 (권장): 비우면 Next.js 프록시(/api → localhost:8080)를 사용해 CORS 문제를 피합니다.
NEXT_PUBLIC_API_URL=

# Vercel Production — 서버 전용 (브라우저 NEXT_PUBLIC_API_URL 비움)
# API_REWRITE_TARGET=https://api.herfree.kr

# 직접 백엔드 호출이 필요할 때만 주석 해제 (CORS 설정 필요):
# NEXT_PUBLIC_API_URL=http://localhost:8080

# ── 소셜 로그인 (프론트: 공개 ID만 / secret 은 backend/local-secrets.yml) ──
#
# [카카오] developers.kakao.com > 앱 키 > REST API 키
NEXT_PUBLIC_OAUTH_KAKAO_CLIENT_ID=
#
# [구글] Google Cloud Console > OAuth 2.0 클라이언트 ID (…apps.googleusercontent.com)
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=
#
# [네이버] developers.naver.com > Application > Client ID
NEXT_PUBLIC_OAUTH_NAVER_CLIENT_ID=
#
# Redirect URI (각 콘솔에 동일하게 등록):
#   http://localhost:3000/auth/callback/kakao
#   http://localhost:3000/auth/callback/google
#   http://localhost:3000/auth/callback/naver

# Privacy-safe product analytics. 비워두면 PostHog 전송은 꺼지고 내부 이벤트 로그만 사용합니다.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

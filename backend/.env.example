# Local backend secrets — copy to OS env or IDE run config. Never commit real values.
# PowerShell example:
#   $env:S3_ACCESS_KEY="..."
#   $env:S3_SECRET_KEY="..."
#   ./gradlew bootRun

S3_BUCKET=herfree-dev-uploads
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Optional local analytics pseudonymisation salt; keep it different from JWT_SECRET.
ANALYTICS_HASH_SALT=

# Optional local field-level encryption for journal memo values.
# Production/staging require a separate 32-byte base64/64-char hex key.
HEALTH_DATA_ENCRYPTION_KEY=
HEALTH_DATA_REKEY_ON_STARTUP=false
ADMIN_ACCESS_ALLOWED_CIDRS=127.0.0.1/32

# Aliases (optional): AWS_S3_BUCKET, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

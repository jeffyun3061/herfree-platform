# API base URL for local frontend development.
# The server-side same-origin proxy uses API_REWRITE_TARGET in deployed environments.
API_REWRITE_TARGET=
NEXT_PUBLIC_API_URL=

# OAuth redirect origin.
# Dev: http://localhost:3000
# Prod: https://herpfree.co.kr
NEXT_PUBLIC_OAUTH_REDIRECT_ORIGIN=http://localhost:3000

# 아래 provider는 build 전에 Client ID 존재 여부를 검사합니다.
NEXT_PUBLIC_OAUTH_REQUIRED_PROVIDERS=kakao,google,naver

# Kakao client id.
NEXT_PUBLIC_OAUTH_KAKAO_CLIENT_ID=

# Google client id.
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=

# Naver client id.
NEXT_PUBLIC_OAUTH_NAVER_CLIENT_ID=

# Production OAuth client ids are configured only in the production environment.
# Redirect URI examples:
#   http://localhost:3000/auth/callback/{kakao|google|naver}
#   https://herpfree.co.kr/auth/callback/{kakao|google|naver}

# Optional product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

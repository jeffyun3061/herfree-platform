# Dev S3 + OAuth — gitignored. Never commit.
# AWS 콘솔에서 만든 버킷 이름과 IAM 키를 그대로 넣으세요.
app:
  s3:
    bucket: "herfree-dev-uploads"
    access-key: "YOUR_DEV_ACCESS_KEY"
    secret-key: "YOUR_DEV_SECRET_KEY"

  # 소셜 로그인 (카카오·구글·네이버) — client-secret 은 백엔드에만 둡니다.
  # redirect-uri 는 각 개발자 콘솔에 등록한 값과 동일해야 합니다.
  oauth:
    kakao:
      client-id: "YOUR_KAKAO_REST_API_KEY"
      client-secret: "YOUR_KAKAO_CLIENT_SECRET"
      redirect-uri: "http://localhost:3000/auth/callback/kakao"
    google:
      client-id: "YOUR_GOOGLE_OAUTH_CLIENT_ID"
      client-secret: "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
      redirect-uri: "http://localhost:3000/auth/callback/google"
    naver:
      client-id: "YOUR_NAVER_CLIENT_ID"
      client-secret: "YOUR_NAVER_CLIENT_SECRET"
      redirect-uri: "http://localhost:3000/auth/callback/naver"

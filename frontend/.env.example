# 로컬 개발 (권장): 비우면 Next.js 프록시(/api → localhost:8080)를 사용해 CORS 문제를 피합니다.
NEXT_PUBLIC_API_URL=

# Vercel Production — 서버 전용 (브라우저 NEXT_PUBLIC_API_URL 비움)
# API_REWRITE_TARGET=https://api.herfree.kr

# 직접 백엔드 호출이 필요할 때만 주석 해제 (CORS 설정 필요):
# NEXT_PUBLIC_API_URL=http://localhost:8080

# ── 소셜 로그인 (프론트: 공개 ID만 / secret 은 backend/local-secrets.yml) ──
#
# [카카오] developers.kakao.com
#   앱 → 플랫폼 키 → REST API 키
#   제품 설정 → 카카오 로그인 ON
#   로그인 리다이렉트 URI: http://localhost:3000/auth/callback/kakao
NEXT_PUBLIC_OAUTH_KAKAO_CLIENT_ID=
#
# [구글] console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
#   OAuth 2.0 클라이언트 ID (웹 애플리케이션)
#   승인된 리디렉션 URI: http://localhost:3000/auth/callback/google
#   (api.herfree.co.kr 이 아님 — 프론트 callback URL)
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=
#
# [네이버] developers.naver.com → Application
#   서비스 URL: http://localhost:3000
#   Callback URL: http://localhost:3000/auth/callback/naver
#   Client Secret 은 backend/local-secrets.yml (client-id 와 다름)
NEXT_PUBLIC_OAUTH_NAVER_CLIENT_ID=
#
# 운영(herpfree.co.kr) 시 각 콘솔에도 동일 패턴으로 등록:
#   https://herpfree.co.kr/auth/callback/{kakao|google|naver}

# Privacy-safe product analytics. 비워두면 PostHog 전송은 꺼지고 내부 이벤트 로그만 사용합니다.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

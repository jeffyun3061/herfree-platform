{
  "name": "herfree-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/dev-frontend.ps1",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .next) { Remove-Item -Recurse -Force .next }; npm run dev\"",
    "dev:next": "next dev -H 0.0.0.0 -p 3000",
    "check:oauth": "node scripts/validate-oauth-env.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:security-headers": "node scripts/validate-security-headers.mjs",
    "prebuild": "npm run check:oauth && npm run check:architecture",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:staging": "playwright test --project=chromium",
    "e2e:staging:smoke": "playwright test --project=chromium --grep \"release smoke\"",
    "e2e:staging:mutation": "playwright test e2e/bff-session.spec.ts e2e/release.spec.ts --project=chromium --grep \"staging data flow\""
  },
  "dependencies": {
    "next": "^15.5.21",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "eslint": {
      "minimatch": {
        "brace-expansion": "1.1.17"
      }
    },
    "form-data": ">=4.0.6",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.10",
    "sharp": "0.35.1"
  }
}

# Herfree API — multi-stage build (Gradle bootJar → JRE 17 runtime)
FROM eclipse-temurin:17-jdk@sha256:068a8f9ae4b74d9a20de3ecca771ba1a6437f1d7a8a8ad6deaf9dbdd2274397a AS builder
WORKDIR /workspace

COPY backend/gradlew backend/gradle backend/build.gradle.kts backend/settings.gradle.kts ./
COPY backend/gradle/wrapper ./gradle/wrapper
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew

COPY backend/src ./src
RUN ./gradlew bootJar --no-daemon -x test

# RDS uses an AWS private CA. Build a dedicated truststore instead of weakening
# hostname verification or replacing the JVM truststore used by HTTPS clients.
COPY infra/certs/rds-global-bundle.pem /tmp/rds-global-bundle.pem
RUN mkdir -p /tmp/rds-certs \
    && awk '/-----BEGIN CERTIFICATE-----/ {n++} n > 0 {print > ("/tmp/rds-certs/rds-ca-" n ".pem")}' /tmp/rds-global-bundle.pem \
    && for cert in /tmp/rds-certs/*.pem; do \
         alias="$(basename "${cert}" .pem)"; \
         keytool -importcert -noprompt -alias "${alias}" -file "${cert}" \
           -keystore /workspace/rds-truststore.p12 -storetype PKCS12 -storepass changeit; \
       done \
    && keytool -list -keystore /workspace/rds-truststore.p12 -storetype PKCS12 -storepass changeit >/dev/null \
    && rm -rf /tmp/rds-certs /tmp/rds-global-bundle.pem

FROM eclipse-temurin:17-jre-jammy@sha256:475d8e96b4b2bfe08999e5e854755c773af1581acdf959a4545d88f0696a2339
USER root
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 nonroot \
    && useradd --system --uid 65532 --gid 65532 --no-create-home nonroot
WORKDIR /app

COPY --from=builder --chown=65532:65532 /workspace/build/libs/*.jar app.jar
COPY --from=builder --chown=65532:65532 /workspace/rds-truststore.p12 /app/certs/rds-truststore.p12

EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["java", "-Duser.timezone=UTC", "-jar", "/app/app.jar"]

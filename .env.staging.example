# staging 전용 예시. 실제 값은 /opt/herfree/config/.env.staging 또는 Secrets Manager에만 저장한다.
SPRING_PROFILES_ACTIVE=staging
SPRING_DATASOURCE_URL=jdbc:mysql://STAGING_RDS_ENDPOINT:3306/herfree_staging?serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=herfree_staging
SPRING_DATASOURCE_PASSWORD=<STAGING_DB_PASSWORD>

JWT_SECRET=<STAGING_RANDOM_32_BYTES_OR_MORE>
ANALYTICS_HASH_SALT=<STAGING_RANDOM_32_BYTES_OR_MORE>
JWT_ACCESS_EXPIRATION=3600
AWS_REGION=ap-northeast-2
CLOUDWATCH_LOG_GROUP=/herfree/staging/api
CORS_ALLOWED_ORIGINS=https://staging.herpfree.co.kr
TRUSTED_PROXY_CIDRS=127.0.0.1/32

S3_BUCKET=herfree-staging-uploads
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=
APP_RETENTION_EVENT_DAYS=30
APP_RETENTION_RESET_TOKEN_GRACE_DAYS=7
APP_RETENTION_ADMIN_AUDIT_DAYS=90
APP_RETENTION_ROLE_AUDIT_DAYS=90

ADMIN_BOOTSTRAP_ENABLED=false
APP_MAIL_MODE=smtp
APP_MAIL_FROM=herpfree3@gmail.com
SPRING_MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<STAGING_SMTP_USERNAME>
SPRING_MAIL_PASSWORD=<STAGING_SMTP_PASSWORD>
PASSWORD_RESET_FRONTEND_BASE_URL=https://staging.herpfree.co.kr

OAUTH_KAKAO_CLIENT_ID=<KAKAO_DEV_REST_API_KEY>
OAUTH_KAKAO_CLIENT_SECRET=<KAKAO_DEV_CLIENT_SECRET>
OAUTH_KAKAO_REDIRECT_URI=https://staging.herpfree.co.kr/auth/callback/kakao
OAUTH_GOOGLE_CLIENT_ID=<GOOGLE_DEV_CLIENT_ID>
OAUTH_GOOGLE_CLIENT_SECRET=<GOOGLE_DEV_CLIENT_SECRET>
OAUTH_GOOGLE_REDIRECT_URI=https://staging.herpfree.co.kr/auth/callback/google
OAUTH_NAVER_CLIENT_ID=<NAVER_DEV_CLIENT_ID>
OAUTH_NAVER_CLIENT_SECRET=<NAVER_DEV_CLIENT_SECRET>
OAUTH_NAVER_REDIRECT_URI=https://staging.herpfree.co.kr/auth/callback/naver

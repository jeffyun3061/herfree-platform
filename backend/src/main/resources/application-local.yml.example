# Copy to application-local.yml (gitignored). Do not commit application-local.yml.
spring:
  config:
    activate:
      on-profile: local
    import:
      - optional:file:./local-secrets.yml
      - optional:file:./backend/local-secrets.yml

  datasource:
    url: jdbc:mysql://localhost:3306/herfree_db?serverTimezone=UTC&characterEncoding=UTF-8
    username: herfree_user
    password: herfree_pass

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

jwt:
  secret: ${JWT_SECRET}
  access-expiration-seconds: 3600

app:
  bootstrap:
    enabled: true
    email: admin@herfree.local
    password: HerfreeAdmin01!
    nickname: HerfreeOps
    sync-existing: true
  demo-seed:
    enabled: true
    password: Demo1234!
    sync-existing: true
    supplement-enabled: true
  s3:
    bucket: ${S3_BUCKET:${AWS_S3_BUCKET:herfree-dev-uploads}}
    region: ${S3_REGION:${AWS_REGION:ap-northeast-2}}
    public-base-url: ${S3_PUBLIC_BASE_URL:}
  password-reset:
    frontend-base-url: http://localhost:3000
  mail:
    mode: console
    from: noreply@herfree.local
  oauth:
    kakao:
      client-id: ${OAUTH_KAKAO_CLIENT_ID:}
      client-secret: ${OAUTH_KAKAO_CLIENT_SECRET:}
      redirect-uri: ${OAUTH_KAKAO_REDIRECT_URI:http://localhost:3000/auth/callback/kakao}
    google:
      client-id: ${OAUTH_GOOGLE_CLIENT_ID:}
      client-secret: ${OAUTH_GOOGLE_CLIENT_SECRET:}
      redirect-uri: ${OAUTH_GOOGLE_REDIRECT_URI:http://localhost:3000/auth/callback/google}
    naver:
      client-id: ${OAUTH_NAVER_CLIENT_ID:}
      client-secret: ${OAUTH_NAVER_CLIENT_SECRET:}
      redirect-uri: ${OAUTH_NAVER_REDIRECT_URI:http://localhost:3000/auth/callback/naver}

springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: true

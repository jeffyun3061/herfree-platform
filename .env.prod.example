# docker-compose.prod.yml 용 — .env.prod 로 복사 후 값을 채운다 (git 커밋 금지)
MYSQL_DATABASE=herfree_db
MYSQL_USER=herfree_user
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# openssl rand -base64 32 로 생성
JWT_SECRET=change_me_jwt_secret_min_32_chars
ANALYTICS_HASH_SALT=change_me_analytics_hash_salt_min_32_chars

JWT_ACCESS_EXPIRATION=3600

# Vercel 또는 Amplify production URL (preview 도메인도 쉼표로 추가 가능)
# Amplify 예: https://main.d1234abcd.amplifyapp.com
# 커스텀 도메인 연결 후: https://herpfree.co.kr
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

NEXT_PUBLIC_OAUTH_REDIRECT_ORIGIN=https://herpfree.co.kr
NEXT_PUBLIC_OAUTH_REQUIRED_PROVIDERS=kakao,google,naver
NEXT_PUBLIC_OAUTH_KAKAO_CLIENT_ID=
NEXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_OAUTH_NAVER_CLIENT_ID=

# 게시글 이미지 (S3 presigned upload)
S3_BUCKET=herfree-prod-uploads
S3_REGION=ap-northeast-2
# VPS에 IAM 역할을 붙일 수 있으면 키를 비워 두고 역할만 사용 (권장)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# CloudFront 등 CDN URL (선택, 없으면 버킷 직접 URL)
S3_PUBLIC_BASE_URL=

# Admin bootstrap — 운영 필수 false (docker-compose도 false 고정)
ADMIN_BOOTSTRAP_ENABLED=false

# 비밀번호 재설정 메일 (운영: smtp + SES/SendGrid 등)
APP_MAIL_MODE=smtp
APP_MAIL_FROM=noreply@herpfree.co.kr
SPRING_MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
PASSWORD_RESET_FRONTEND_BASE_URL=https://herpfree.co.kr

# X-Forwarded-For 신뢰 범위
# Nginx가 같은 EC2에서 Spring으로 프록시하면 127.0.0.1/32.
# ALB 뒤라면 ALB가 위치한 서브넷 CIDR만 넣고 0.0.0.0/0은 금지.
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# 소셜 로그인 (백엔드 secret — Amplify/Vercel env 에 넣지 말 것)
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_KAKAO_REDIRECT_URI=https://herpfree.co.kr/auth/callback/kakao
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://herpfree.co.kr/auth/callback/google
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_NAVER_REDIRECT_URI=https://herpfree.co.kr/auth/callback/naver

# RDS(B안) JDBC — serverTimezone=UTC 필수
# SPRING_DATASOURCE_URL=jdbc:mysql://host:3306/herfree_db?serverTimezone=UTC&characterEncoding=UTF-8

# 호환 별칭 (선택): AWS_S3_BUCKET, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

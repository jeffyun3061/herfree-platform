# Production API environment template.
# Copy only on the EC2 host to /opt/herfree/config/.env.prod, fill the values,
# and run: chmod 600 /opt/herfree/config/.env.prod
# Never commit the real file. Local MySQL credentials do not belong here.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://PRODUCTION_RDS_ENDPOINT:3306/herfree?serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=herfree_app
SPRING_DATASOURCE_PASSWORD=<PRODUCTION_DB_PASSWORD>

JWT_SECRET=<PRODUCTION_RANDOM_32_BYTES_OR_MORE>
ANALYTICS_HASH_SALT=<DIFFERENT_RANDOM_32_BYTES_OR_MORE>
JWT_ACCESS_EXPIRATION=3600

AWS_REGION=ap-northeast-2
CLOUDWATCH_LOG_GROUP=/herfree/production/api
CORS_ALLOWED_ORIGINS=https://herpfree.co.kr
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Use the EC2 instance role. Do not place AWS access keys in this file.
S3_BUCKET=herfree-prod-uploads
S3_REGION=ap-northeast-2
S3_PUBLIC_BASE_URL=
APP_RETENTION_EVENT_DAYS=90
APP_RETENTION_RESET_TOKEN_GRACE_DAYS=7
APP_RETENTION_ADMIN_AUDIT_DAYS=365
APP_RETENTION_ROLE_AUDIT_DAYS=365

ADMIN_BOOTSTRAP_ENABLED=false
APP_AUTH_RATE_LIMIT_ENABLED=true

APP_MAIL_MODE=smtp
APP_MAIL_FROM=noreply@herpfree.co.kr
SPRING_MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<PRODUCTION_SMTP_USERNAME>
SPRING_MAIL_PASSWORD=<PRODUCTION_SMTP_PASSWORD>
PASSWORD_RESET_FRONTEND_BASE_URL=https://herpfree.co.kr

OAUTH_KAKAO_CLIENT_ID=<KAKAO_PROD_REST_API_KEY>
OAUTH_KAKAO_CLIENT_SECRET=<KAKAO_PROD_CLIENT_SECRET>
OAUTH_KAKAO_REDIRECT_URI=https://herpfree.co.kr/auth/callback/kakao
OAUTH_GOOGLE_CLIENT_ID=<GOOGLE_PROD_CLIENT_ID>
OAUTH_GOOGLE_CLIENT_SECRET=<GOOGLE_PROD_CLIENT_SECRET>
OAUTH_GOOGLE_REDIRECT_URI=https://herpfree.co.kr/auth/callback/google
OAUTH_NAVER_CLIENT_ID=<NAVER_PROD_CLIENT_ID>
OAUTH_NAVER_CLIENT_SECRET=<NAVER_PROD_CLIENT_SECRET>
OAUTH_NAVER_REDIRECT_URI=https://herpfree.co.kr/auth/callback/naver

# Herfree API — multi-stage build (Gradle bootJar → JRE 17 runtime)
FROM eclipse-temurin:17-jdk@sha256:068a8f9ae4b74d9a20de3ecca771ba1a6437f1d7a8a8ad6deaf9dbdd2274397a AS builder
WORKDIR /workspace

COPY backend/gradlew backend/gradle backend/build.gradle.kts backend/settings.gradle.kts ./
COPY backend/gradle/wrapper ./gradle/wrapper
RUN chmod +x gradlew

COPY backend/src ./src
RUN ./gradlew bootJar --no-daemon -x test

FROM gcr.io/distroless/java17-debian13:nonroot@sha256:4f682dfb4d9721e3f139fff791cd065b94e8dde1d3a4ae60b9ae86e165c4acf4
WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /workspace/build/libs/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-Duser.timezone=UTC", "-jar", "/app/app.jar"]
